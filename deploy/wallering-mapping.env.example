# Copy to /etc/wallering-mapping.env after commissioning.
WR_MAPPING_ROOT=/mnt/nvme/mapping
WR_MAPPING_MOUNT=/mnt/nvme
WR_MAPPING_CONFIG=/opt/wallering/mapping_functionality/configs/oakd-survey.json

# Optional PX4 integration. Install/source ROS in the recorder's runtime first.
# The drone_autonomy_platform container uses DDS domain 1.
# ROS_DOMAIN_ID=1
# WR_MAPPING_ROS_SETUP=/opt/ros/humble/setup.bash
# WR_MAPPING_ROS_OVERLAY=/ros2_ws/install/setup.bash
# WR_MAPPING_CONFIG=/opt/wallering/mapping_functionality/configs/oakd-mavros-survey.json
# WR_MAPPING_TELEMETRY_CONFIG=/opt/wallering/mapping_functionality/configs/mavros-survey.json
# WR_MAPPING_GNSS_PROFILE=/etc/wallering/gnss-accuracy.json
# WR_MAPPING_DEVICE_ID=your-commissioned-device-id
