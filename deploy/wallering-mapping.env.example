# Native ROS service: install official depthai_ros_driver, MAVROS and rosbag2 MCAP.
WR_MAPPING_ROOT=/mnt/nvme/mapping
WR_MAPPING_MOUNT=/mnt/nvme
WR_MAPPING_CONFIG=/opt/wallering/mapping_functionality/configs/oakd-ros.yaml
WR_MAPPING_ROS_SETUP=/opt/ros/humble/setup.bash
ROS_DOMAIN_ID=1
WR_MAPPING_WARMUP=60
WR_MAPPING_DURATION=0
# Reuse an existing MAVROS owner by default. Set true only if this service owns it.
WR_MAPPING_START_MAVROS=false
# WR_MAPPING_FCU_URL=/dev/serial/by-id/your-adapter:921600
# WR_MAPPING_DEVICE_ID=your-commissioned-device-id
# Isolated camera commissioning only (no PX4 acceptance):
# WR_MAPPING_CAMERA_ONLY=true
# Interactive Docker fallback on hosts without ROS:
# WR_PLATFORM_IMAGE=drone_autonomy_platform:orin
# WR_MAPPING_SERIAL_DEVICE=/dev/serial/by-id/your-adapter
