[Unit]
Description=Wallering ROS2 MCAP mapping recorder
After=local-fs.target
RequiresMountsFor=/mnt/nvme/mapping

[Service]
Type=simple
User=wr-mapping
SupplementaryGroups=plugdev dialout
WorkingDirectory=/opt/wallering/mapping_functionality
EnvironmentFile=-/etc/wallering-mapping.env
ExecStart=/bin/bash /opt/wallering/mapping_functionality/deploy/record-session.sh
KillSignal=SIGINT
KillMode=control-group
# ROS launch owns child shutdown. Hashing the stopped bag can take much longer
# and must finish before power removal.
TimeoutStopSec=infinity
Restart=no
UMask=0027
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
