[Unit]
Description=Wallering OAK mapping recorder
After=local-fs.target
RequiresMountsFor=/mnt/nvme/mapping

[Service]
Type=simple
User=wr-mapping
SupplementaryGroups=plugdev
WorkingDirectory=/opt/wallering/mapping_functionality
ExecStart=/bin/bash /opt/wallering/mapping_functionality/deploy/record-session.sh
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=no
UMask=0027
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

